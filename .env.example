# Copy settings into your process environment; the app does not auto-load this file.
UMEP_DATA_DIR=.data
UMEP_UPLOAD_LIMIT_MB=100
UMEP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional QGIS diagnostic interpreter and plugin parent directory.
UMEP_QGIS_PYTHON=/usr/bin/python3
# UMEP_PLUGIN_DIR=/path/to/directory/containing/processing_umep
# QGIS_PREFIX_PATH=/usr
# CHROMIUM_PATH=/usr/bin/chromium
